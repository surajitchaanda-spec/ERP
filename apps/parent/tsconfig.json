{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "paths": {
      "@ui/*": ["shared/ui/*"],
      "@api/*": ["shared/api/*"],
      "@features/*": ["features/*"]
    }
  },
  "include": ["src", "e2e"],
  "exclude": ["node_modules"]
}
