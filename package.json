{
  "name": "erp-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx && stylelint \"**/*.{css,scss}\"",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:integration && npm run test:contract",
    "test:unit": "jest --config jest.config.ts",
    "test:integration": "jest --config tests/integration/jest.integration.config.ts",
    "test:contract": "jest --config contract-tests/pact/jest.pact.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.3.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.2",
    "playwright": "^1.42.1",
    "prettier": "^3.2.5",
    "storybook": "^8.0.0",
    "stylelint": "^16.3.1",
    "stylelint-config-standard": "^36.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "turbo": "^1.12.5",
    "typescript": "^5.4.2",
    "axios-mock-adapter": "^1.22.0",
    "identity-obj-proxy": "^3.0.0",
    "@playwright/test": "^1.42.1",
    "@types/styled-components": "^5.1.34",
    "jest-styled-components": "^7.2.0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "i18next": "^23.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.6.2",
    "styled-components": "^6.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix",
    "*.{json,md,css,scss,ts,tsx,js,jsx}": "prettier --write"
  }
}
